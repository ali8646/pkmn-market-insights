# Required for Prisma and the ETL jobs.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Required when using authenticated API requests.
NEON_AUTH_BASE_URL="https://<branch-auth-url>"
NEON_AUTH_JWKS_URL="https://<branch-auth-url>/.well-known/jwks.json"
# Optional when the Neon Auth branch defines an audience.
# NEON_AUTH_AUDIENCE="your-audience"

# Optional local server configuration.
# PORT=3001
